<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>1c42d4f4-92b8-4df7-9a59-1dfda9e5d470</Id>
  <Version>1.9.0.0</Version>
  <ProviderName>Complemento personal</ProviderName>
  <DefaultLocale>es-GT</DefaultLocale>
  <DisplayName DefaultValue="Alerta personal de resoluciones"/>
  <Description DefaultValue="Advierte sobre resoluciones APLICA y NO APLICA contradictorias para una cédula repetida."/>
  <IconUrl DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/bryanalexexevair-lab/alertas-resoluciones"/>
  <AppDomains>
    <AppDomain>https://bryanalexexevair-lab.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.9"/>
      <Set Name="DialogApi" MinVersion="1.1"/>
      <Set Name="SharedRuntime" MinVersion="1.1"/>
      <Set Name="AddinCommands" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/taskpane.html?v=1.9.0"/>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="ResolutionAlerts.Tab">
              <Label resid="Tab.Label"/>
              <Group id="ResolutionAlerts.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="ResolutionAlerts.OpenPane">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/icon-32.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/icon-64.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/taskpane.html?v=1.9.0"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://bryanalexexevair-lab.github.io/alertas-resoluciones/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Alerta de resoluciones"/>
        <bt:String id="Tab.Label" DefaultValue="Mis alertas"/>
        <bt:String id="Group.Label" DefaultValue="Resoluciones"/>
        <bt:String id="Button.Label" DefaultValue="Abrir alertas"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="El complemento se cargó. Activa las alertas una vez en este libro; luego podrás cerrar el panel."/>
        <bt:String id="Button.Tooltip" DefaultValue="Abre la configuración personal de alertas de resoluciones."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

